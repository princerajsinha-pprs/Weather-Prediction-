def wmo_info(code, is_day=True):
    info = WMO_MAP.get(code, ("Unknown", "?", "?"))
    return info[0], (info[1] if is_day else info[2])


def uv_label(uv):
    if uv <= 2:  return "Low"
    if uv <= 5:  return "Moderate"
    if uv <= 7:  return "High"
    if uv <= 10: return "Very High"
    return "Extreme"


def wind_direction(deg):
    return ["N", "NE", "E", "SE", "S", "SW", "W", "NW"][round(deg / 45) % 8]


def pressure_label(hpa):
    if hpa > 1020: return "High ↑"
    if hpa < 1000: return "Low ↓"
    return "Normal"


def to_fahrenheit(c):
    return c * 9 / 5 + 32


