def aqi_label(aqi):
    if aqi is None: return "N/A"
    if aqi <= 50:   return "Good"
    if aqi <= 100:  return "Moderate"
    if aqi <= 150:  return "Unhealthy (sensitive)"
    if aqi <= 200:  return "Unhealthy"
    if aqi <= 300:  return "Very Unhealthy"
    return "Hazardous"


def fetch_aqi(lat, lon):
    url = (f"{AQI_URL}?latitude={lat}&longitude={lon}"
           "&current=us_aqi,pm2_5,pm10&timezone=auto")
    return fetch_json(url).get("current")


def fetch_json(url: str) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": "WeatherCast/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode())
    except urllib.error.URLError as e:
        # Some Python installs (esp. macOS) lack SSL certs -> retry once
        if isinstance(getattr(e, "reason", None), ssl.SSLError):
            ctx = ssl._create_unverified_context()
            with urllib.request.urlopen(req, timeout=20, context=ctx) as r:
                return json.loads(r.read().decode())
        raise


def geocode(city: str, india_only: bool = True) -> dict:
    # Known Indian city -> instant, no network call
    for name, (lat, lon, state) in INDIAN_CITIES.items():
        if name.lower() == city.strip().lower():
            return {"lat": lat, "lon": lon, "city": name, "region": state, "country": "IN"}
    base = f"{GEO_URL}?name={urllib.parse.quote(city)}&count=1&language=en&format=json"
    data = fetch_json(base + "&countryCode=IN")          # India first
    if not data.get("results"):
        if india_only:
            raise ValueError(f'No Indian city found for "{city}"')
        data = fetch_json(base)                           # fall back to worldwide
    if not data.get("results"):
        raise ValueError(f'No city found for "{city}"')
    r = data["results"][0]
    return {
        "lat": r["latitude"],
        "lon": r["longitude"],
        "city": r.get("name", city),
        "region": r.get("admin1", ""),
        "country": r.get("country_code", ""),
    }


def fetch_weather(lat: float, lon: float) -> dict:
    params = (
        f"latitude={lat}&longitude={lon}"
        "&current=temperature_2m,relative_humidity_2m,apparent_temperature,"
        "is_day,precipitation,weather_code,wind_speed_10m,wind_direction_10m,"
        "surface_pressure"
        "&hourly=temperature_2m,apparent_temperature,precipitation_probability,"
        "weather_code,is_day"
        "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,"
        "sunset,precipitation_probability_max,uv_index_max,wind_speed_10m_max"
        "&timezone=auto&forecast_days=7"
    )
    return fetch_json(f"{BASE_URL}?{params}")


