        self.entry.bind("<FocusOut>", lambda e: self._restore_placeholder())
        self.entry.bind("<Return>", lambda e: self._on_search())

        self.search_btn = tk.Button(sf, text="Search", command=self._on_search,
                                    bg=t["accent"], fg="#1a1a1a",
                                    font=("Arial", 11, "bold"), relief="flat",
                                    padx=18, pady=6, cursor="hand2")
        self.search_btn.pack(side="left")

        self.india_chk = tk.Checkbutton(sf, text="India only", variable=self.india_only,
                                        bg=t["bg"], fg=t["text"], selectcolor=t["card"],
                                        activebackground=t["bg"], activeforeground=t["text"])
        self.india_chk.pack(side="left", padx=10)


        # Indian city quick-select chips
        self.chip_frame = tk.Frame(self, bg=t["bg"])
        self.chip_frame.pack(fill="x", padx=20, pady=(0, 6))
        self.chip_btns = []
        names = list(INDIAN_CITIES)
        per_row = 9
        for i, name in enumerate(names):
            b = tk.Button(self.chip_frame, text=name, font=("Arial", 9), relief="flat",
                          bg=t["card"], fg=t["text"], cursor="hand2", padx=8, pady=3, bd=0,
                          command=lambda n=name: self._search_thread(n))
