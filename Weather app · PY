    # ── search handlers ──
    def _clear_placeholder(self):
        if self.search_var.get() == "Search city…":
            self.entry.delete(0, "end")

    def _restore_placeholder(self):
        if not self.search_var.get():
            self.entry.insert(0, "Search city…")

    def _on_search(self):
        q = self.search_var.get().strip()
        if not q or q == "Search city…":
            return
        self._search_thread(q)

    def _set_unit(self, u):
        self.unit.set(u)
        t = CHROME
        self.btn_c.configure(bg=t["accent"] if u == "C" else t["card"],
                             fg="#1a1a1a" if u == "C" else t["muted"])
        self.btn_f.configure(bg=t["accent"] if u == "F" else t["card"],
                             fg="#1a1a1a" if u == "F" else t["muted"])
        if self._raw_data:
            self._render_all()

    # ── background thread ──
    def _search_thread(self, city):
        self.status_lbl.configure(text="Fetching…", fg="#ffce3d")
        self.search_btn.configure(state="disabled")
        threading.Thread(target=self._load_data, args=(city,), daemon=True).start()

    def _poll_queue(self):
        try:
            while True:
                self._q.get_nowait()()
        except queue.Empty:
            pass
        self.after(100, self._poll_queue)

    def _load_data(self, city):
        try:
            loc = geocode(city, self.india_only.get())
            data = fetch_weather(loc["lat"], loc["lon"])
            try:
                aqi = fetch_aqi(loc["lat"], loc["lon"])
            except Exception:
                aqi = None                                 # AQI is optional

            def done():
                self._raw_data, self._location, self._aqi = data, loc, aqi
                try:
                    self._render_all()
                    self.status_lbl.configure(text="", fg="#ff8888")
                except Exception as e:
                    traceback.print_exc()
                    self.status_lbl.configure(text=f"⚠ Display error: {e!r}", fg="#ff8888")
                self.search_btn.configure(state="normal")
            self._q.put(done)
        except Exception as e:
            traceback.print_exc()
            msg = f"⚠ {type(e).__name__}: {e}"

            def fail():
                self.status_lbl.configure(text=msg, fg="#ff8888")
                self.search_btn.configure(state="normal")
            self._q.put(fail)

    # ── unit helpers ──
    def _fmt(self, c):
        if self.unit.get() == "C":
            return f"{round(c)}°C"
        return f"{round(to_fahrenheit(c))}°F"

    def _fnum(self, c):
        return str(round(c if self.unit.get() == "C" else to_fahrenheit(c)))

    # ── theme ──
    def _apply_theme(self, theme):
        self.theme = t = theme
        style = ttk.Style()
        style.configure("TNotebook", background=CHROME["bg"])
        style.configure("TNotebook.Tab", background=CHROME["card"], foreground=CHROME["muted"])
        style.map("TNotebook.Tab",
                  background=[("selected", t["bg"])],
                  foreground=[("selected", t["accent"])])
        for tab in (self.tab_now, self.tab_hourly, self.tab_7day):
            tab.configure(bg=t["bg"])

    def _on_wheel(self, e):
        try:
            idx = self.nb.index(self.nb.select())
        except tk.TclError:
            return
        canvas = {0: self._canvas_now, 2: self._canvas_7day}.get(idx)
        if canvas is None:
            return
        if getattr(e, "num", 0) == 4:
            canvas.yview_scroll(-3, "units")
        elif getattr(e, "num", 0) == 5:
            canvas.yview_scroll(3, "units")
        else:
            canvas.yview_scroll(int(-e.delta / 120) * 3 or (-3 if e.delta > 0 else 3), "units")

    def _render_all(self):
        d, loc, c = self._raw_data, self._location, self._raw_data["current"]
        t = get_theme(c["weather_code"], bool(c["is_day"]))
        self._apply_theme(t)
        self._render_now(d, loc, c, t)
        self._render_hourly(d, t)
        self._render_7day(d, t)

    # ── NOW tab ──
    def _render_now(self, d, loc, c, t):
        for w in self.tab_now.winfo_children():
            w.destroy()

        label, icon = wmo_info(c["weather_code"], bool(c["is_day"]))
        local_now = datetime.fromisoformat(c["time"])   # city's local time
        now_str = local_now.strftime("%A, %d %b %Y  •  %H:%M")

        canvas = tk.Canvas(self.tab_now, bg=t["bg"], highlightthickness=0)
        self._canvas_now = canvas
        sb = ttk.Scrollbar(self.tab_now, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        inner = tk.Frame(canvas, bg=t["bg"])
        win = canvas.create_window((0, 0), window=inner, anchor="nw")
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(win, width=e.width))
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))

        def lbl(parent, text, size=12, bold=False, color=None, pady=0):
            tk.Label(parent, text=text,
                     font=("Arial", size, "bold" if bold else "normal"),
                     bg=t["bg"], fg=color or t["text"], anchor="w"
                     ).pack(fill="x", padx=20, pady=pady)

        def card_frame(parent, padx=20, pady=6):
            f = tk.Frame(parent, bg=t["card"], padx=12, pady=10)
            f.pack(fill="x", padx=padx, pady=pady)
            return f

        lbl(inner, loc["city"], 22, bold=True, pady=12)
        lbl(inner, f"{loc['region']}  {loc['country']}", 11, color=t["muted"])
        lbl(inner, now_str, 10, color=t["muted"], pady=2)

        row = card_frame(inner, pady=10)
        tk.Label(row, text=icon, font=("Segoe UI Emoji", 56),
                 bg=t["card"], fg=t["text"]).pack(side="left", padx=10)
        info_f = tk.Frame(row, bg=t["card"])
        info_f.pack(side="left", padx=10)
        tk.Label(info_f, text=self._fmt(c["temperature_2m"]),
                 font=("Georgia", 52, "bold"), bg=t["card"], fg=t["text"]).pack(anchor="w")
        tk.Label(info_f, text=label, font=("Arial", 14),
                 bg=t["card"], fg=t["muted"]).pack(anchor="w")
        tk.Label(info_f, text=f"Feels like {self._fmt(c['apparent_temperature'])}",
                 font=("Arial", 11), bg=t["card"], fg=t["muted"]).pack(anchor="w")

        lbl(inner, "Current Conditions", 13, bold=True, pady=(16, 4))
        g = tk.Frame(inner, bg=t["bg"])
        g.pack(fill="x", padx=20, pady=4)
        g.columnconfigure((0, 1, 2), weight=1, uniform="col")

        uv_today = d["daily"]["uv_index_max"][0] or 0
        stats = [
            ("💧 Humidity", f"{c['relative_humidity_2m']}%", ""),
            ("🌬 Wind", f"{round(c['wind_speed_10m'])} km/h", wind_direction(c["wind_direction_10m"])),
            ("☀ UV Index (max)", f"{round(uv_today)}", uv_label(uv_today)),
            ("🌡 Pressure", f"{round(c['surface_pressure'])} hPa", pressure_label(c["surface_pressure"])),
            ("🌧 Precip", f"{c['precipitation']} mm", "now"),
            ("📅 High/Low",
             f"{self._fmt(d['daily']['temperature_2m_max'][0])} / {self._fmt(d['daily']['temperature_2m_min'][0])}", ""),
        ]
        for i, (title, val, sub) in enumerate(stats):
            cf = tk.Frame(g, bg=t["card"], padx=10, pady=10)
            cf.grid(row=i // 3, column=i % 3, sticky="nsew", padx=4, pady=4)
            tk.Label(cf, text=title, font=("Arial", 9), bg=t["card"], fg=t["muted"], anchor="w").pack(fill="x")
            tk.Label(cf, text=val, font=("Arial", 16, "bold"), bg=t["card"], fg=t["text"], anchor="w").pack(fill="x")
            if sub:
                tk.Label(cf, text=sub, font=("Arial", 9), bg=t["card"], fg=t["muted"], anchor="w").pack(fill="x")

        lbl(inner, "Air Quality (US AQI)", 13, bold=True, pady=(16, 4))
        af = card_frame(inner)
        a = self._aqi or {}
        aqi_val = a.get("us_aqi")
        for title, val, sub in [
            ("AQI", "–" if aqi_val is None else str(round(aqi_val)), aqi_label(aqi_val)),
            ("PM2.5", "–" if a.get("pm2_5") is None else f"{a['pm2_5']:.0f} µg/m³", ""),
            ("PM10", "–" if a.get("pm10") is None else f"{a['pm10']:.0f} µg/m³", ""),
        ]:
            ff = tk.Frame(af, bg=t["card"])
            ff.pack(side="left", expand=True)
            tk.Label(ff, text=title, font=("Arial", 9), bg=t["card"], fg=t["muted"]).pack()
            tk.Label(ff, text=val, font=("Arial", 16, "bold"), bg=t["card"], fg=t["text"]).pack()
            if sub:
                tk.Label(ff, text=sub, font=("Arial", 9), bg=t["card"], fg=t["accent"]).pack()

        lbl(inner, "Sun", 13, bold=True, pady=(16, 4))
        sf2 = card_frame(inner)
        sr = d["daily"]["sunrise"][0].split("T")[1]
        ss = d["daily"]["sunset"][0].split("T")[1]
        for side, ic, name, val in [("left", "🌅", "Sunrise", sr), ("right", "🌇", "Sunset", ss)]:
            ff = tk.Frame(sf2, bg=t["card"])
            ff.pack(side=side, expand=True, fill="x")
            tk.Label(ff, text=ic, font=("Segoe UI Emoji", 24), bg=t["card"], fg=t["text"]).pack()
            tk.Label(ff, text=name, font=("Arial", 9), bg=t["card"], fg=t["muted"]).pack()
            tk.Label(ff, text=val, font=("Arial", 16, "bold"), bg=t["card"], fg=t["text"]).pack()

        arc_c = tk.Canvas(inner, bg=t["card"], height=90, highlightthickness=0)
        arc_c.pack(fill="x", padx=20, pady=(0, 6))
        arc_c.bind("<Configure>", lambda e: self._draw_sun_arc(arc_c, sr, ss, local_now, t))

        lbl(inner, "Wind Detail", 13, bold=True, pady=(16, 4))
        wf = card_frame(inner)
        wdir = wind_direction(c["wind_direction_10m"])
        tk.Label(wf, text=f"Speed: {round(c['wind_speed_10m'])} km/h  |  "
                          f"Direction: {wdir} ({round(c['wind_direction_10m'])}°)",
                 font=("Arial", 12), bg=t["card"], fg=t["text"]).pack(anchor="w")
        self._draw_wind_compass(wf, c["wind_direction_10m"], t)

        tk.Frame(inner, bg=t["bg"], height=20).pack()

    def _draw_sun_arc(self, canvas, sunrise, sunset, now, t):
        canvas.delete("all")
        W = canvas.winfo_width() or 860
        H = 90
        cx, cy = W // 2, H - 25
        rx, ry = W // 2 - 30, H - 40

        sr_h, sr_m = map(int, sunrise.split(":"))
        ss_h, ss_m = map(int, sunset.split(":"))
        now_mins = now.hour * 60 + now.minute
        sr_mins = sr_h * 60 + sr_m
        ss_mins = ss_h * 60 + ss_m
        pct = max(0.0, min(1.0, (now_mins - sr_mins) / max(ss_mins - sr_mins, 1)))

        canvas.create_arc(cx - rx, cy - ry, cx + rx, cy + ry, start=0, extent=180,
                          style="arc", outline=t["muted"], width=2)
        ang = math.radians(180 - pct * 180)
        sx = cx + rx * math.cos(ang)
        sy = cy - ry * math.sin(ang)
        canvas.create_oval(sx - 10, sy - 10, sx + 10, sy + 10, fill=t["accent"], outline="")
        canvas.create_text(cx - rx, cy + 14, text=sunrise, fill=t["muted"], font=("Arial", 9))
        canvas.create_text(cx + rx, cy + 14, text=sunset, fill=t["muted"], font=("Arial", 9))
        canvas.create_text(cx, cy + 14, text=f"{round(pct * 100)}% of daylight",
                           fill=t["muted"], font=("Arial", 9))

    def _draw_wind_compass(self, parent, deg, t):
        size = 100
        c = tk.Canvas(parent, bg=t["card"], width=size, height=size, highlightthickness=0)
        c.pack(pady=8)
        cx = cy = size // 2
        r = size // 2 - 10
        c.create_oval(cx - r, cy - r, cx + r, cy + r, outline=t["muted"], fill=t["card"], width=1)
        for name, a in [("N", 90), ("E", 0), ("S", 270), ("W", 180)]:
            rd = math.radians(a)
            c.create_text(cx + (r - 10) * math.cos(rd), cy - (r - 10) * math.sin(rd),
                          text=name, fill=t["muted"], font=("Arial", 8, "bold"))
        # wind_direction = where wind comes FROM; arrow points where it blows TO
        rad = math.radians(90 - (deg + 180))
        ax, ay = cx + (r - 18) * math.cos(rad), cy - (r - 18) * math.sin(rad)
        c.create_line(cx, cy, ax, ay, fill=t["accent"], width=3, arrow="last")

    # ── 48-HOUR tab ──
    def _render_hourly(self, d, t):
        for w in self.tab_hourly.winfo_children():
            w.destroy()

        frame = tk.Frame(self.tab_hourly, bg=t["bg"])
        frame.pack(fill="both", expand=True)
        tk.Label(frame, text="48-Hour Forecast", font=("Georgia", 15, "bold"),
                 bg=t["bg"], fg=t["accent"], pady=10).pack()

        cols = ("Time", "Icon", "Temp", "Feels Like", "Rain %", "Condition")
        tv = ttk.Treeview(frame, columns=cols, show="headings", height=22)
        sb = ttk.Scrollbar(frame, orient="vertical", command=tv.yview)
        tv.configure(yscrollcommand=sb.set)

        style = ttk.Style()
        style.configure("Treeview", background=t["card"], fieldbackground=t["card"],
                        foreground=t["text"], rowheight=28, font=("Arial", 10))
        style.configure("Treeview.Heading", background=t["bg"], foreground=t["accent"],
                        font=("Arial", 10, "bold"))
        style.map("Treeview", background=[("selected", t["accent"])],
                  foreground=[("selected", "#1a1a1a")])

        for col, w2 in zip(cols, [90, 40, 80, 90, 60, 160]):
            tv.heading(col, text=col)
            tv.column(col, width=w2, anchor="center")

        h = d["hourly"]
        now_key = d["current"]["time"][:13] + ":00"      # city's current hour
        start = h["time"].index(now_key) if now_key in h["time"] else 0

        for n, i in enumerate(range(start, min(start + 48, len(h["time"])))):
            dt = datetime.fromisoformat(h["time"][i])
            cond, icon = wmo_info(h["weather_code"][i], bool(h["is_day"][i]))
            rain = h["precipitation_probability"][i]
            tv.insert("", "end", tags=("even" if n % 2 == 0 else "odd",), values=(
                dt.strftime("%a %H:%M"), icon,
                f"{self._fnum(h['temperature_2m'][i])}°",
                f"{self._fnum(h['apparent_temperature'][i])}°",
                f"{rain if rain is not None else 0}%", cond))

        tv.tag_configure("even", background=t["card"])
        tv.tag_configure("odd", background=t["bg"])
        tv.pack(side="left", fill="both", expand=True, padx=(12, 0), pady=8)
        sb.pack(side="right", fill="y", pady=8, padx=(0, 4))

    # ── 7-DAY tab ──
    def _render_7day(self, d, t):
        for w in self.tab_7day.winfo_children():
            w.destroy()

        canvas = tk.Canvas(self.tab_7day, bg=t["bg"], highlightthickness=0)
        self._canvas_7day = canvas
        sb = ttk.Scrollbar(self.tab_7day, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        inner = tk.Frame(canvas, bg=t["bg"])
        win = canvas.create_window((0, 0), window=inner, anchor="nw")
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(win, width=e.width))
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))

        tk.Label(inner, text="7-Day Outlook", font=("Georgia", 15, "bold"),
                 bg=t["bg"], fg=t["accent"], pady=10).pack()

        daily = d["daily"]
        g_min = min(daily["temperature_2m_min"])
        g_max = max(daily["temperature_2m_max"])
        g_rng = max(g_max - g_min, 1)

        for i, date_str in enumerate(daily["time"]):
            dt = datetime.fromisoformat(date_str)
            name = "Today" if i == 0 else ("Tomorrow" if i == 1 else dt.strftime("%A, %d %b"))
            cond, icon = wmo_info(daily["weather_code"][i], True)
            lo = daily["temperature_2m_min"][i]
            hi = daily["temperature_2m_max"][i]
            rain = daily["precipitation_probability_max"][i] or 0
            uv = daily["uv_index_max"][i] or 0

            row = tk.Frame(inner, bg=t["card"], pady=10, padx=14)
            row.pack(fill="x", padx=14, pady=4)

            tk.Label(row, text=name, font=("Arial", 11, "bold"), bg=t["card"],
                     fg=t["text"], width=16, anchor="w").pack(side="left")
            tk.Label(row, text=f"{icon}  {cond}", font=("Arial", 11), bg=t["card"],
                     fg=t["muted"], width=22, anchor="w").pack(side="left")
            tk.Label(row, text=f"💧{rain}%", font=("Arial", 10), bg=t["card"],
                     fg="#74c0fc", width=8).pack(side="left")
            tk.Label(row, text=f"UV {round(uv)}", font=("Arial", 10), bg=t["card"],
                     fg=t["muted"], width=6).pack(side="left")

            bar_f = tk.Frame(row, bg=t["card"])
            bar_f.pack(side="left", fill="x", expand=True, padx=8)
            bar = tk.Canvas(bar_f, bg=t["bg"], height=8, highlightthickness=0)
            bar.pack(fill="x", pady=4)

            def draw_bar(e, bar=bar, lo=lo, hi=hi):
                bar.delete("all")
                W = e.width
                x0 = int((lo - g_min) / g_rng * W)
                x1 = max(int((hi - g_min) / g_rng * W), x0 + 4)
                bar.create_rectangle(x0, 0, x1, 8, fill=t["accent"], outline="")
            bar.bind("<Configure>", draw_bar)

            tk.Label(row, text=self._fmt(hi), font=("Arial", 11, "bold"),
                     bg=t["card"], fg=t["text"]).pack(side="left")
            tk.Label(row, text=f"/{self._fmt(lo)}", font=("Arial", 11),
                     bg=t["card"], fg=t["muted"]).pack(side="left")

        tk.Label(inner, text="Week Summary", font=("Georgia", 13, "bold"),
                 bg=t["bg"], fg=t["accent"]).pack(pady=(14, 4))
        sf = tk.Frame(inner, bg=t["card"], padx=16, pady=12)
        sf.pack(fill="x", padx=14, pady=4)
        for name, val in [
            ("Weekly High", self._fmt(max(daily["temperature_2m_max"]))),
            ("Weekly Low", self._fmt(min(daily["temperature_2m_min"]))),
            ("Max Rain Chance", f"{max(x or 0 for x in daily['precipitation_probability_max'])}%"),
        ]:
            f = tk.Frame(sf, bg=t["card"])
            f.pack(side="left", expand=True)
            tk.Label(f, text=name, font=("Arial", 9), bg=t["card"], fg=t["muted"]).pack()
            tk.Label(f, text=val, font=("Arial", 18, "bold"), bg=t["card"], fg=t["text"]).pack()

        tk.Frame(inner, bg=t["bg"], height=20).pack()


