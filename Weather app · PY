CHROME = THEMES["clear_night"]   # header/search bar keep fixed colours


def get_theme(code, is_day):
    if code in (95, 96, 99):                                   return THEMES["stormy"]
    if code in (71, 73, 75, 77, 85, 86):                       return THEMES["snowy"]
    if code in (51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82): return THEMES["rainy"]
    if code in (3, 45, 48):                                    return THEMES["cloudy"]
    return THEMES["clear_day"] if is_day else THEMES["clear_night"]


# ───────────────────────── APP ─────────────────────────
class WeatherApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("WeatherCast")
        self.geometry("1000x820")
        self.minsize(720, 560)
        self.configure(bg="#0d1b3e")

        self.unit = tk.StringVar(value="C")
        self.theme = THEMES["clear_night"]
        self._raw_data = None
        self._location = {}
        self._aqi = None
        self.india_only = tk.BooleanVar(value=True)
        self._q = queue.Queue()          # worker thread -> UI thread
        self._canvas_now = None
        self._canvas_7day = None

        self._build_ui()
        self._poll_queue()
        self.bind_all("<MouseWheel>", self._on_wheel)
        self.bind_all("<Button-4>", self._on_wheel)
        self.bind_all("<Button-5>", self._on_wheel)
        self.after(300, lambda: self._search_thread("Raipur"))

