        uf = tk.Frame(top, bg=t["bg"])
        uf.pack(side="right", padx=20)
        self.btn_c = tk.Button(uf, text="°C", width=4, command=lambda: self._set_unit("C"),
                               relief="flat", bg=t["accent"], fg="#1a1a1a",
                               font=("Arial", 10, "bold"), cursor="hand2", bd=0)
        self.btn_c.pack(side="left", padx=2)
        self.btn_f = tk.Button(uf, text="°F", width=4, command=lambda: self._set_unit("F"),
                               relief="flat", bg=t["card"], fg=t["muted"],
                               font=("Arial", 10), cursor="hand2", bd=0)
        self.btn_f.pack(side="left", padx=2)

        sf = tk.Frame(self, bg=t["bg"], pady=10)
        sf.pack(fill="x", padx=20)

        self.search_var = tk.StringVar()
        self.entry = tk.Entry(sf, textvariable=self.search_var, width=40,
                              font=("Arial", 13), bg=t["card"], fg=t["text"],
                              insertbackground=t["text"], relief="flat",
                              highlightthickness=1, highlightcolor=t["accent"],
                              highlightbackground=t["muted"])
